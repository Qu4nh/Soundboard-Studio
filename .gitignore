# Allow only the paths and file types listed below.
*

!/.gitattributes
!/.gitignore
!/electron-builder.json
!/index.html
!/LICENSE
!/package-lock.json
!/package.json
!/README.md
!/SECURITY.md
!/Start Soundboard.cmd
!/vite.config.mjs

!/.github/
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.md
!/.github/pull_request_template.md
!/.github/workflows/
!/.github/workflows/ci.yml

!/desktop/
!/desktop/*.cjs
!/desktop/*.ps1
!/desktop/starter.json
!/src/
!/src/*.js
!/src/*.jsx
!/src/*.css
!/src/locales.json

!/public/
!/public/assets/
!/public/assets/loudness-presets.png
!/public/assets/sound-default.png
!/public/brand/
!/public/brand/*.png
!/public/brand/*.svg
!/public/brand/app.ico
!/public/noise-gate.js

!/docs/
!/docs/architecture.md
!/docs/benchmarks.md
!/docs/guide.vi.md
!/docs/media/
!/docs/media/audio-mixer.png
!/docs/media/community-library.png
!/docs/media/playback-demo.gif
!/docs/media/soundboard-studio.png

!/scripts/
!/scripts/benchmark-replay.mjs
!/scripts/brand-after-pack.cjs
!/scripts/dev.mjs
!/scripts/launch.cjs
!/tests/
!/tests/*.test.cjs
!/tests/fixtures/
!/tests/fixtures/artwork.png
